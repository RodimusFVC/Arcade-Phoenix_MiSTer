<misterromdescription>
    <name>City Attack (Petaco S.A., Bootleg Of Pleiads)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pleiads</series>
    <year>1981</year>
    <manufacturer>bootleg (Petaco S.A.)</manufacturer>
    <category>Shooter</category>

    <setname>cityatta</setname>
    <parent>pleiads</parent>
    <mameversion>0289</mameversion>
    <rbf>Phoenix</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="E4,FE">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Coinage" bits="4" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Unknown" bits="5" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On"/>
        <dip name="Unknown" bits="2" ids="On,Off"/>
        <dip name="Bonus Life" bits="3" ids="3K,5K"/>
        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: MAME regions, layout in rtl/boards/phoenix/phoenix_board.sv -->
    <rom index="0" md5="none" zip="cityatta.zip|pleiads.zip">

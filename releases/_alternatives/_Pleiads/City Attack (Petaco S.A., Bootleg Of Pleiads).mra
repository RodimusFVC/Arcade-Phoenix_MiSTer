        <part crc="85866607" name="10-2716.bin"/>
        <part crc="a841d511" name="9-2716.bin"/>
        <part crc="e38eeb83" name="ic41a-7611.bin"/>
        <part crc="7a1bcb1e" name="ic40a-7611.bin"/>
    </rom>


<misterromdescription>
    <name>Germ Wars</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Survival</series>
    <year>1982</year>
    <manufacturer>Microtrain (Seevend Automaten license)</manufacturer>
    <category>Shooter</category>

    <setname>germwars</setname>
    <parent>germwars</parent>
    <mameversion>0289</mameversion>
    <rbf>Phoenix</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FE,FE">
        <dip name="Lives" bits="0,1" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="2,3" ids="25000,35000,45000,55000" values="3,2,1,0"/>
        <dip name="Free Play" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="5,6" ids="5C/1C,3C/1C,2C/1C,1C/1C"/>
        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
    </switches>

